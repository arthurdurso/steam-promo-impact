# Modelo das variáveis de ambiente do projeto.
# Uso: copie para `.env` (que é ignorado pelo Git) e preencha com os seus valores.
#   cp .env.example .env
# No Databricks, estes valores vêm do Secret scope `steam`, não deste arquivo.

# --- APIs -------------------------------------------------------
# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# IsThereAnyDeal API key (histórico de preços): https://isthereanydeal.com/apps/my/
ITAD_API_KEY=

# --- Ingestão ---------------------------------------------------
# Pasta onde os coletores gravam o JSON cru.
# Local: data/raw  |  Databricks: /Volumes/steam/bronze/raw
RAW_DATA_BASE_PATH=data/raw
